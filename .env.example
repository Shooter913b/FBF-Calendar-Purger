# Canvas
CANVAS_BASE_URL=https://your-institution.instructure.com

# OAuth (recommended — any instructor can sign in)
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Dev-only fallback: shared token, no OAuth (set DEV_MODE=true)
CANVAS_ACCESS_TOKEN=
DEV_MODE=false

# API
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-32-byte-string

# App
FBF_PATTERNS_PATH=config/fbf_patterns.yaml
RATE_LIMIT_REQUESTS_PER_SECOND=8
LOG_LEVEL=INFO
ENABLE_INSPECT=false

# Anonymous visitor stats (random cookie UUIDs only; no personal data)
# VISITOR_STORE_PATH=data/visitors.json
